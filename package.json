{
  "name": "aurora-lyrics",
  "version": "0.1.1",
  "private": true,
  "description": "Apple Music companion with synchronized word lyrics for Windows 11",
  "author": "Aurora Lyrics contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "bridge:build": "dotnet publish native/WindowsMediaBridge -c Release -r win-x64 --self-contained true -o native/publish/win-x64 -p:PublishSingleFile=true",
    "dist:win": "npm run bridge:build && npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "esbuild": "^0.27.0",
    "eslint": "10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "io.auroralyrics.app",
    "productName": "Aurora Lyrics",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/publish/win-x64",
        "to": "bridge",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Aurora-Lyrics-${version}-${arch}-nsis.${ext}"
    },
    "portable": {
      "artifactName": "Aurora-Lyrics-${version}-${arch}-portable.${ext}"
    }
  }
}
